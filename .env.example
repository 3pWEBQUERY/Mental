# --- Pflicht ---------------------------------------------------------------
# Railway: ${{postgres.DATABASE_URL}}
DATABASE_URL=postgres://lichtung:lichtung@localhost:5432/lichtung
# Mindestens 32 zufällige Zeichen: openssl rand -base64 48
SESSION_SECRET=
# Öffentliche Adresse – bestimmt auch die WebAuthn-Domain (Passkeys), HSTS und upgrade-insecure-requests
APP_URL=http://localhost:3000

# --- Railway Storage Bucket (Credentials-Tab des Buckets, als Referenzen) ---
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
ENDPOINT=
# 1, wenn der Bucket Path-Style-URLs verlangt (steht im Credentials-Tab)
BUCKET_PATH_STYLE=

# --- Web-Push (npm run vapid:generate) --------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.ch

# --- Moderation (Anbieter mit Datenverarbeitung in EU/CH, vor Launch festlegen)
# POST { text, language } → { crisis: none|concern|acute, flags: string[] }
MODERATION_API_URL=
MODERATION_API_KEY=
# POST image/webp → { allowed: boolean }
MODERATION_IMAGE_API_URL=

# --- Optional ---------------------------------------------------------------
# Verschlüsselung von Notfallplan, Briefen und Check-in-Notizen (web UND worker; offline sichern!).
# openssl rand -base64 32
# DATA_ENCRYPTION_KEY=
# WEBAUTHN_RP_ID=jiaia.app
# DB_POOL_MAX=10
# Nur lokal/Tests:
# HIBP_DISABLED=1
# REGISTRATIONS_PER_IP_PER_DAY=1000
# USERNAME_CHECKS_PER_10_MIN=1000
# ADMIN_ALLOW_PASSWORD=1   # Admin ohne Passkey – wirkt nie in Produktion

# Nachtbereitschaft der Moderation (22–7 Uhr): 1 = Krisen-Pushes rund um die Uhr, kein Nacht-Hinweis in der App
# NIGHT_MODERATION=1
